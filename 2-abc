## 3. Session model

```ts
export interface Session {
  id: string; createdAt: string; updatedAt: string;
  state: State; enteredStateAt: string;
  planRevision: number; replanCount: number;

  ticket?: { key: string; summary?: string; description: string; acceptanceCriteria: string[] };

  repo?: {                       // cwd for ALL operations
    path: string; toplevel: string; remote?: string; defaultBranch?: string;
    addedAsWorkspaceFolder: boolean;
  };

  exec?: ExecConfig;             // §5, from .vscode/jira-flow.yml (user-confirmed)

  git?: { baseBranch: string; featureBranch: string; commitMessage: string;
          baseSha?: string; headShaAtStart?: string; stashRef?: string; pushedSha?: string };

  plan?: { revision: number; structured: Plan; markdown: string;
           approvedAt?: string; feedback: string[] };

  impl?: { filesChanged: string[]; iterations: number; summary: string; diffStat: string };

  build?: { command: string; attempts: number; ok: boolean; durationMs: number; logPath: string };

  verify?: { healthUrl: string; httpStatus: number; body: string; at: string; appLogPath: string };

  deploy?: { confirmedAt: string; note?: string };

  regression?: { runnerUrl: string; profile: string; startedAt: string; finishedAt?: string;
                 resultFiles: string[]; screenshots: string[];
                 summary?: { total: number; passed: number; failed: number; skipped: number };
                 manualSteps: string[]; verdict?: 'pass' | 'fail' };

  report?: { format: 'md' | 'docx' | 'both'; paths: string[]; committed: boolean };

  incidents: Incident[];         // §9
  secretRefs: string[];          // KEYS ONLY — e.g. "jiraFlow.<id>.kidPassword"
}
```

Validated with `zod` on every read. Schema version field + migration switch so an in-flight session survives an extension update.

**No secret value is ever a field in this object.**

